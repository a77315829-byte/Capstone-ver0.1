{
	"name": "stotra-backend",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"start": "node ./dist/index.js",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"tsc": "npm run clean && tsc",
		"test:proxy": "npm run tsc && node scripts/smoke-downstream-proxy.js",
		"postinstall": "npm run tsc",
		"dev": "ts-node-dev --respawn --pretty --transpile-only --ignore-watch swagger-output.json ./src/index.ts"
	},
	"dependencies": {
		"axios": "^1.4.0",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-rate-limit": "^6.9.0",
		"jsonwebtoken": "^9.0.1",
		"mongoose": "^7.4.2",
		"morgan": "^1.10.0",
		"node-cache": "^5.1.2",
		"swagger-ui-express": "^5.0.0"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.17",
		"@types/jsonwebtoken": "^9.0.2",
		"@types/morgan": "^1.9.10",
		"@types/node": "^20.5.0",
		"@types/swagger-ui-express": "^4.1.3",
		"@typescript-eslint/parser": "^6.3.0",
		"swagger-autogen": "^2.23.5",
		"ts-node": "^10.9.1",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.1.6"
	}
}
