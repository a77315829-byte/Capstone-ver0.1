OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGO_DB_NAME=entitude

# KIS(한국투자증권) 모의투자 Open API - 시세 조회 전용(계좌번호 없음, 주문 불가)
KIS_APP_KEY=
KIS_APP_SECRET=

