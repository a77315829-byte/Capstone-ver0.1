# 기본 로컬 개발 구성: Ollama가 판단 근거 문장만 생성합니다.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# OpenAI를 사용할 때만 아래 값을 채우고 LLM_PROVIDER=openai로 변경합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 통합 저장소에서는 비워 두면 ../../server/.env의 Atlas 계정을 재사용합니다.
# 독립 실행 또는 로컬 MongoDB를 쓸 때만 직접 지정합니다.
MONGO_URI=
MONGO_DB_NAME=anttitude_ai_judgment

# KIS(한국투자증권) 모의투자 Open API - 시세 조회 전용(계좌번호 없음, 주문 불가)
KIS_APP_KEY=
KIS_APP_SECRET=

# 서비스 포트는 start.bat과 README에서 8003으로 고정합니다.
