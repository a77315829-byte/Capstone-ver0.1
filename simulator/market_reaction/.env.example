# 서버 설정
API_HOST=0.0.0.0
API_PORT=8002

# Ollama (LLM 모델)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1
OLLAMA_TEMPERATURE=0.3

# RAG (scripts/build_rag_index.py 전용)
DART_API_KEY=
RAG_INDEX_DIR=data/rag_index
OLLAMA_EMBEDDING_MODEL=bge-m3

# MongoDB (RAG 저장소, server/.env 와 같은 Atlas 클러스터 값을 그대로 복사해 쓸 수 있음)
STOTRA_MONGODB_USERNAME=
STOTRA_MONGODB_PASSWORD=
STOTRA_MONGODB_CLUSTER=
MONGO_DB_NAME=
RAG_MAX_CACHED_STOCKS=
