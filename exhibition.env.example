# Copy to .env.exhibition (setup creates it without overwriting an existing file).
# Current exhibition: run web/API/AI together on ONE PC with npm start.
# A separate app project is outside this setup.
HOST=127.0.0.1
PORT=3010
SERVICE_HOST=127.0.0.1
# School Wi-Fi: NETWORK_ACCESS=lan and HOST=0.0.0.0.
# Keep SERVICE_HOST and all AI/Ollama URLs on loopback.
NETWORK_ACCESS=local

# Preserve your existing DB names. Credentials may stay in server/.env.
MONGODB_URI=
# Existing service .env URIs are preserved; set these only to override them.
SCENARIO_MONGODB_URI=
JUDGMENT_MONGODB_URI=
MONGO_DB_NAME=antitude_defense
SCENARIO_DB_NAME=anttitude_scenario
JUDGMENT_DB_NAME=anttitude_ai_judgment
STOTRA_JWT_SECRET=
# Shared by the local Node/Python services; never put it in app/ or a VITE_* variable.
EXHIBITION_SERVICE_KEY=

SCENARIO_SERVICE_URL=http://127.0.0.1:8000
MARKET_REACTION_URL=http://127.0.0.1:8002
AI_JUDGMENT_SERVICE_URL=http://127.0.0.1:8003
# auto: try AI, then use explicit rule-based results. rules: skip AI services.
AI_MODE=auto
AI_SERVICE_TIMEOUT_MS=60000
SALARY_AI_TIMEOUT_MS=60000
MARKET_SERVICE_TIMEOUT_MS=120000
# Keep the Python pipeline shorter than MARKET_SERVICE_TIMEOUT_MS / 1000.
MARKET_PIPELINE_TIMEOUT_SECONDS=110
SCENARIO_TIMEOUT_MS=90000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tested on this 8GB CPU PC; a larger model requires separate timing checks.
OLLAMA_MODEL=qwen2.5:1.5b
# Optional absolute path for a standalone Ollama installation.
OLLAMA_EXECUTABLE=
STOTRA_LLM_BASE_URL=http://127.0.0.1:11434
STOTRA_LLM_MODEL=qwen2.5:1.5b
SALARY_AI_MODEL=qwen2.5:1.5b
OLLAMA_ASSET_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3
STOTRA_AI_USE_LLM=true

# Explicit local exhibition setting. For public hosting configure real Turnstile keys.
AUTH_CAPTCHA_MODE=disabled
TURNSTILE_SITE_KEY=
STOTRA_TURNSTILE_SECRET=
# Same-origin access on :3010 needs no CORS entry. Add dev frontend origins only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
