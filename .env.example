GEMINI_API_KEY=

# mongodb 또는 memory. 실제 베타는 mongodb를 사용하세요.
DATA_BACKEND=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=anttitude_scenario
MONGODB_CONNECT_TIMEOUT_MS=3000

# 인증 서버 연결 전 로컬 테스트용 사용자
DEFAULT_USER_ID=beta-user

# 과거 일봉 수집용 KIS Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=real
